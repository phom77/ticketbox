{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Accepted admission feedback v1",
  "type": "object",
  "required": [
    "ticketId",
    "usedAt"
  ],
  "properties": {
    "ticketId": {
      "type": "string",
      "format": "uuid"
    },
    "usedAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
