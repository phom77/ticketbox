{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:ticketbox:notification-command:v1",
  "type": "object",
  "required": ["schemaVersion", "eventType", "eventId", "aggregateId", "userId", "occurredAt", "correlationId", "payload"],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventType": {"enum": ["ticketing.order-confirmed", "ticketing.order-refunded", "ticketing.event-cancelled", "ticketing.event-postponed", "concert.reminder-requested",
      "ticketing.ticket-transfer-offered", "ticketing.ticket-transfer-accepted", "ticketing.ticket-transfer-declined",
      "ticketing.ticket-transfer-cancelled", "ticketing.ticket-transfer-expired",
      "ticketing.refund-request-received", "ticketing.refund-request-approved", "ticketing.refund-request-rejected",
      "ticketing.refund-request-submitted"]},
    "eventId": {"type": "string", "format": "uuid"},
    "aggregateId": {"type": "string", "format": "uuid"},
    "userId": {"type": "string", "format": "uuid"},
    "occurredAt": {"type": "string", "format": "date-time"},
    "correlationId": {"type": "string", "minLength": 1, "maxLength": 200},
    "payload": {"type": "object"}
  },
  "allOf": [
    {
      "if": {"properties": {"eventType": {"enum": ["ticketing.order-confirmed", "ticketing.order-refunded"]}}},
      "then": {
        "properties": {
          "payload": {
            "required": ["orderId", "amount"],
            "properties": {
              "orderId": {"type": "string", "format": "uuid"},
              "amount": {"type": "number", "minimum": 0},
              "orderReference": {"type": "string", "pattern": "^DH-[0-9]{8,19}$"}
            }
          }
        }
      }
    },
    {"if": {"properties": {"eventType": {"enum": ["concert.reminder-requested", "ticketing.event-postponed"]}}}, "then": {"properties": {"payload": {"required": ["concertId", "concertTitle", "eventDate"], "properties": {"concertId": {"type": "string", "format": "uuid"}, "eventDate": {"type": "string", "format": "date-time"}}}}}},
    {
      "if": {"properties": {"eventType": {"enum": ["ticketing.ticket-transfer-offered", "ticketing.ticket-transfer-accepted", "ticketing.ticket-transfer-declined", "ticketing.ticket-transfer-cancelled", "ticketing.ticket-transfer-expired"]}}},
      "then": {
        "properties": {
          "payload": {
            "required": ["transferId", "ticketId", "concertId", "concertTitle", "eventDate", "otherPartyName", "role"],
            "properties": {
              "transferId": {"type": "string", "format": "uuid"},
              "ticketId": {"type": "string", "format": "uuid"},
              "concertId": {"type": "string", "format": "uuid"},
              "otherPartyName": {"type": "string", "minLength": 1, "maxLength": 200},
              "role": {"enum": ["SENDER", "RECIPIENT"]}
            }
          }
        }
      }
    },
    {
      "if": {"properties": {"eventType": {"enum": ["ticketing.refund-request-received", "ticketing.refund-request-approved", "ticketing.refund-request-rejected", "ticketing.refund-request-submitted"]}}},
      "then": {
        "properties": {
          "payload": {
            "required": ["refundRequestId", "orderId", "concertId", "concertTitle"],
            "properties": {
              "refundRequestId": {"type": "string", "format": "uuid"},
              "orderId": {"type": "string", "format": "uuid"},
              "concertId": {"type": "string", "format": "uuid"},
              "orderReference": {"type": "string", "pattern": "^DH-[0-9]{8,19}$"},
              "note": {"type": "string", "minLength": 1, "maxLength": 1000}
            }
          }
        }
      }
    },
    {"if": {"properties": {"eventType": {"const": "ticketing.event-cancelled"}}}, "then": {"properties": {"payload": {"required": ["concertId", "concertTitle"], "properties": {"concertId": {"type": "string", "format": "uuid"}}}}}}
  ]
}
