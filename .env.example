# Optional: compose.yaml runs with local demo defaults without this file.
# These are development credentials; deployments require separate credentials.
COMPOSE_PROJECT_NAME=ticketbox
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=18091
APP_PUBLIC_URL=http://localhost:18091
APP_ALLOWED_ORIGINS=http://localhost:18091,http://127.0.0.1:18091
JWT_SECRET=ticketbox-local-demo-secret-at-least-sixty-four-characters-change-before-deploy
PAYMENT_SERVICE_TOKEN=ticketbox-local-payment-service-token-change-before-deploy
NOTIFICATION_SERVICE_TOKEN=ticketbox-local-notification-service-token-change-before-deploy
GRAFANA_PASSWORD=ticketbox-local

# Optional integrations. MOCK payment and artist biographies work without keys.
MOMO_PARTNER_CODE=
MOMO_ACCESS_KEY=
MOMO_SECRET_KEY=
MOMO_RETURN_URL=http://localhost:18091/payment/result
MOMO_IPN_URL=
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_QUERY_URL=
VNPAY_RETURN_URL=http://localhost:18091/payment/result
VNPAY_IPN_URL=
ARTIST_BIO_AI_PROVIDER=mock
ARTIST_BIO_AI_BASE_URL=https://api.openai.com/v1
ARTIST_BIO_AI_API_KEY=
ARTIST_BIO_AI_MODEL=gpt-4o-mini
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
