<?xml version='1.0' encoding='utf-8'?>
<entity-mappings xmlns="https://jakarta.ee/xml/ns/persistence/orm" version="3.1">
    <mapped-superclass class="org.ticketbox.ticketing.domain.BaseEntity" access="FIELD" metadata-complete="true">
        <pre-persist method-name="initializeTimestamps" />
        <pre-update method-name="updateTimestamp" />
        <attributes>
            <id name="id">
                <column name="id" updatable="false" nullable="false" />
                <generated-value strategy="UUID" />
            </id>
            <basic name="createdAt">
                <column name="created_at" nullable="false" updatable="false" />
            </basic>
            <basic name="updatedAt">
                <column name="updated_at" nullable="false" />
            </basic>
        </attributes>
    </mapped-superclass>
    <entity class="org.ticketbox.ticketing.order.domain.Order" access="FIELD" metadata-complete="true">
        <table name="orders" />
        <attributes>
            <basic name="userId">
                <column name="user_id" nullable="false" />
            </basic>
            <basic name="concertId">
                <column name="concert_id" nullable="false" />
            </basic>
            <basic name="status">
                <column name="status" nullable="false" length="20" />
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="totalAmount">
                <column name="total_amount" nullable="false" precision="12" scale="0" />
            </basic>
            <basic name="idempotencyKey">
                <column name="idempotency_key" length="255" />
            </basic>
            <basic name="paymentProvider">
                <column name="payment_provider" length="20" />
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="paymentRef">
                <column name="payment_ref" length="255" />
            </basic>
            <basic name="paymentUrl">
                <column name="payment_url" column-definition="TEXT" />
            </basic>
            <basic name="paidAt">
                <column name="paid_at" />
            </basic>
            <basic name="expiresAt">
                <column name="expires_at" />
            </basic>
            <one-to-many name="items" target-entity="org.ticketbox.ticketing.order.domain.OrderItem" fetch="LAZY">
                <join-column name="order_id" insertable="false" updatable="false" />
                <cascade>
                    <cascade-persist />
                    <cascade-merge />
                </cascade>
            </one-to-many>
        </attributes>
    </entity>
    <entity class="org.ticketbox.ticketing.order.domain.OrderItem" access="FIELD" metadata-complete="true">
        <table name="order_items" />
        <attributes>
            <basic name="orderId">
                <column name="order_id" nullable="false" />
            </basic>
            <basic name="ticketTypeId">
                <column name="ticket_type_id" nullable="false" />
            </basic>
            <basic name="quantity">
                <column name="quantity" nullable="false" />
            </basic>
            <basic name="unitPrice">
                <column name="unit_price" nullable="false" precision="12" scale="0" />
            </basic>
            <basic name="subtotal">
                <column name="subtotal" nullable="false" precision="12" scale="0" />
            </basic>
        </attributes>
    </entity>
    <entity class="org.ticketbox.ticketing.issuance.domain.Ticket" access="FIELD" metadata-complete="true">
        <table name="tickets" />
        <pre-persist method-name="initializeIssueTime" />
        <attributes>
            <basic name="orderItemId">
                <column name="order_item_id" nullable="false" />
            </basic>
            <basic name="ticketTypeId">
                <column name="ticket_type_id" nullable="false" />
            </basic>
            <basic name="concertId">
                <column name="concert_id" nullable="false" />
            </basic>
            <basic name="userId">
                <column name="user_id" nullable="false" />
            </basic>
            <basic name="qrCode">
                <column name="qr_code" nullable="false" unique="true" length="500" />
            </basic>
            <basic name="qrSecret">
                <column name="qr_secret" nullable="false" length="255" />
            </basic>
            <basic name="status">
                <column name="status" nullable="false" length="20" />
                <enumerated>STRING</enumerated>
            </basic>
            <basic name="issuedAt">
                <column name="issued_at" nullable="false" updatable="false" />
            </basic>
            <basic name="usedAt">
                <column name="used_at" />
            </basic>
        </attributes>
    </entity>
    <entity class="org.ticketbox.ticketing.inventory.hold.domain.TicketHold" access="FIELD" metadata-complete="true">
        <table name="ticket_holds" />
        <attributes>
            <basic name="concertId">
                <column name="concert_id" nullable="false" />
            </basic>
            <basic name="userId">
                <column name="user_id" nullable="false" />
            </basic>
            <basic name="ticketTypeId">
                <column name="ticket_type_id" nullable="false" />
            </basic>
            <basic name="quantity">
                <column name="quantity" nullable="false" />
            </basic>
            <basic name="expiresAt">
                <column name="expires_at" nullable="false" />
            </basic>
            <basic name="sessionToken">
                <column name="session_token" />
            </basic>
        </attributes>
    </entity>
</entity-mappings>